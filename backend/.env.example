OPENROUTER_API_KEY=replace-with-a-server-side-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=ChainTrace AI Graph Lab# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# Authentication
JWT_SECRET=chainsentinel-secure-jwt-secret-key-national-hackathon-2026
JWT_EXPIRES_IN=24h

# Database Configuration (SQLite)
DB_PATH=./data/chainsentinel.db

# Graph Database Configuration (Neo4j)
# If left default or offline, the system seamlessly uses the SQLite BFS graph engine
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Blockchain Provider Endpoints & Explorer API Keys (Live on-chain ingestion)
ALCHEMY_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/replace-with-server-key
ETHEREUM_RPC_URL=https://cloudflare-eth.com
ETHERSCAN_API_KEY=
BITCOIN_API_URL=https://blockstream.info/api
BNB_RPC_URL=https://binance.llamarpc.com
BSCSCAN_API_KEY=
TRON_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=

# Operation Modes
DEMO_MODE=true
ENABLE_BACKGROUND_WORKERS=true

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:3000,null

# Risk & Behaviour Engine Thresholds
FAN_OUT_MIN_RECEIVERS=3
FAN_OUT_WINDOW_MINUTES=10
VELOCITY_THRESHOLD_USD=50000
VELOCITY_WINDOW_HOURS=1
DORMANT_DAYS_THRESHOLD=30
